generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Auth.js models

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // Stats tracking
  highScore       Int @default(0)
  totalGames      Int @default(0)
  currentStreak   Int @default(0)
  longestStreak   Int @default(0)
  lastPlayedAt    DateTime?

  accounts Account[]
  sessions Session[]
  games    Game[]

  // Multiplayer
  hostedRooms GameRoom[]     @relation("HostedRooms")
  roomPlayers PlayerInRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models

model Game {
  id           String    @id @default(cuid())
  userId       String
  mode         String
  status       String    @default("in_progress")
  totalScore   Int       @default(0)
  currentRound Int       @default(1)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds Round[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([totalScore])
  @@index([mode])
}

model Round {
  id          String    @id @default(cuid())
  gameId      String
  roundNumber Int

  actualLat Float
  actualLng Float
  imageId   String

  guessLat  Float?
  guessLng  Float?
  distance  Float?
  score     Int?
  guessedAt DateTime?
  timeSpent Int?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber])
  @@index([gameId])
}

// Multiplayer models

model GameRoom {
  id             String    @id @default(cuid())
  code           String    @unique
  hostId         String
  status         String    @default("waiting")
  mode           String    @default("classic")
  timeLimit      Int       @default(90)
  maxPlayers     Int       @default(4)
  currentRound   Int       @default(0)
  roundStartedAt DateTime?

  host    User           @relation("HostedRooms", fields: [hostId], references: [id])
  players PlayerInRoom[]
  rounds  RoomRound[]

  createdAt DateTime @default(now())

  @@index([code])
  @@index([status])
}

model PlayerInRoom {
  id         String @id @default(cuid())
  roomId     String
  userId     String
  totalScore Int    @default(0)

  room    GameRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guesses RoomGuess[]

  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
}

model RoomRound {
  id          String @id @default(cuid())
  roomId      String
  roundNumber Int
  actualLat   Float
  actualLng   Float
  imageId     String

  room    GameRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guesses RoomGuess[]

  @@unique([roomId, roundNumber])
  @@index([roomId])
}

model RoomGuess {
  id        String   @id @default(cuid())
  roundId   String
  playerId  String
  guessLat  Float
  guessLng  Float
  distance  Float
  score     Int
  timeSpent Int
  guessedAt DateTime @default(now())

  round  RoomRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player PlayerInRoom @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId])
  @@index([roundId])
  @@index([playerId])
}

model Location {
  id       String  @id @default(cuid())
  lat      Float
  lng      Float
  imageId  String
  country  String?
  region   String?
  provider String  @default("mapillary")
  verified Boolean @default(true)

  @@index([provider])
  @@index([region])
}
